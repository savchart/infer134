# Infer134 local development configuration.
# Copy values into your shell or local .env tooling if desired.
# Do not commit real private keys or secrets.

# Provider-node runtime.
INFER134_RUNTIME=vllm
INFER134_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
INFER134_MODEL_REVISION=main
INFER134_VLLM_BASE_URL=http://127.0.0.1:8001/v1
INFER134_VLLM_API_KEY=infer134-local
HF_HOME=.hf-cache

# Local Anvil chain.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
INFERENCE_ESCROW_ADDRESS=
WORKER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
ESCROW_VALUE=1000000000000000
REQUESTED_PAYMENT_WEI=1000000000000000

# Private keys are intentionally omitted here.
# Use only local Anvil dev keys in a local shell or script, never real keys.
